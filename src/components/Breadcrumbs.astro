---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Fil d’Ariane">
  <ol>
    {items.map((item, index) => (
      index === items.length - 1 ? (
        <li aria-current="page">{item.label}</li>
      ) : (
        <li><a href={item.href}>{item.label}</a></li>
      )
    ))}
  </ol>
</nav>
