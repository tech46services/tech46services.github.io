---
import { formatDate } from "../utils/content";

interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  category?: string;
  location?: string;
  service?: string;
  image?: string;
  imageAlt?: string;
  linkLabel?: string;
  elevationClass?: string;
  showDate?: boolean;
}

const {
  title,
  description,
  date,
  href,
  category,
  location,
  service,
  image,
  imageAlt,
  linkLabel = "Lire la suite",
  elevationClass = "elevation-2",
  showDate = true,
} = Astro.props;

const metaParts = [
  category,
  showDate ? formatDate(date) : undefined,
  location,
  service,
].filter(Boolean);
---

<article class:list={["service-card", elevationClass]}>
  {metaParts.length > 0 && <p class="article-meta">{metaParts.join(" · ")}</p>}
  {image && <img src={image} alt={imageAlt || title} class="card-image" loading="lazy" />}
  <h2>{title}</h2>
  <p>{description}</p>
  <a class="inline-link" href={href}>{linkLabel} &rarr;</a>
</article>
