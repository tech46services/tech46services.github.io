---
interface Props {
  activePage?: string;
}

const { activePage = "" } = Astro.props;
const links = [
  { key: "home", href: "/", label: "Accueil" },
  { key: "depannage", href: "/depannage.html", label: "Dépannage" },
  { key: "espace-pro", href: "/espace-pro.html", label: "Espace pro" },
];
const discoverLinks = [
  { key: "realisations", href: "/realisations.html", label: "Réalisations" },
  { key: "conseils-actualites", href: "/conseils-actualites.html", label: "Conseils & actualités" },
  { key: "tarifs", href: "/tarifs.html", label: "Tarifs" },
];
const followingLinks = [
  { key: "apropos", href: "/apropos.html", label: "À propos" },
];
const discoverActive = discoverLinks.some(({ key }) => key === activePage);
---

<header class="top-nav elevation-2">
  <div class="nav-left">
    <a href="/" class="site-logo">
      <img
        src="/assets/img/logo-no-text-96.png"
        srcset="/assets/img/logo-no-text-96.png 96w, /assets/img/logo-no-text-192.png 192w"
        sizes="74px"
        width="96"
        height="73"
        loading="eager"
        decoding="async"
        alt="Tech 46 Services"
      />
    </a>
    <img
      class="logo-secondary"
      src="/assets/img/text-logo-512.png"
      srcset="/assets/img/text-logo-512.png 512w, /assets/img/text-logo-1024.png 1024w"
      sizes="413px"
      width="512"
      height="62"
      loading="eager"
      decoding="async"
      alt="Tech 46 Services"
    />
  </div>

  <a class="nav-quick-call" href="tel:0769754085" aria-label="Appeler Tech 46 Services">
    <span aria-hidden="true" class="nav-quick-call-icon"></span>
  </a>

  <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav id="site-nav" class="nav-links">
    {links.map(({ key, href, label }) => (
      <a href={href} class:list={["nav-link", { active: activePage === key }]} aria-current={activePage === key ? "page" : undefined}>
        {label}
      </a>
    ))}
    <div class="nav-discover">
      <button
        class:list={["nav-link", "nav-discover-toggle", { active: discoverActive }]}
        type="button"
        aria-expanded="false"
        aria-controls="discover-menu"
      >
        Découvrir <span class="nav-discover-chevron" aria-hidden="true"></span>
      </button>
      <div id="discover-menu" class="nav-discover-menu">
        {discoverLinks.map(({ key, href, label }) => (
          <a href={href} class:list={["nav-link", { active: activePage === key }]} aria-current={activePage === key ? "page" : undefined}>
            {label}
          </a>
        ))}
      </div>
    </div>
    {followingLinks.map(({ key, href, label }) => (
      <a href={href} class:list={["nav-link", { active: activePage === key }]} aria-current={activePage === key ? "page" : undefined}>
        {label}
      </a>
    ))}
    <a
      href="/contact.html"
      class:list={["nav-link", "nav-cta", { active: activePage === "contact" }]}
      aria-current={activePage === "contact" ? "page" : undefined}
    >
      Contact <span aria-hidden="true" class="nav-cta-icon"></span>
    </a>
  </nav>
</header>
