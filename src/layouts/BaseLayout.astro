---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/main.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  bodyClass?: string;
  activePage?: string;
  jsonLd?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  bodyClass = "",
  activePage = "",
  jsonLd = "",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content="https://tech46services.fr/assets/img/og-tech46services.webp" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://tech46services.fr/assets/img/og-tech46services.webp" />

    <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon/android-chrome-512x512.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
    <meta name="theme-color" content="#002043" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5RJZZRVC7C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-5RJZZRVC7C", {
        anonymize_ip: true,
        storage: "none",
        client_id: "anonyme",
        allow_ad_personalization_signals: false,
        allow_google_signals: false,
      });
    </script>
  </head>
  <body class={bodyClass}>
    <div class="app-shell">
      <Header activePage={activePage} />
      <slot />
      <Footer />
    </div>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>
