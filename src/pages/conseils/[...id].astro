---
import { getCollection, render } from "astro:content";
import ArticleHeader from "../../components/ArticleHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getPublicEntries } from "../../utils/content";

export async function getStaticPaths() {
  const items = getPublicEntries(await getCollection("conseils"));

  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const canonical = `https://tech46services.fr/conseils/${item.id}.html`;

const breadcrumbItems = [
  { label: "Accueil", href: "/" },
  { label: "Conseils & actualités", href: "/conseils-actualites.html" },
  { label: item.data.title },
];

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: item.data.title,
    description: item.data.description,
    datePublished: item.data.date.toISOString(),
    mainEntityOfPage: canonical,
    author: {
      "@type": "Organization",
      name: "Tech 46 Services",
      url: "https://tech46services.fr/apropos.html",
    },
    publisher: {
      "@type": "Organization",
      name: "Tech 46 Services",
      logo: {
        "@type": "ImageObject",
        url: "https://tech46services.fr/assets/img/logo-tech46.png",
      },
    },
    ...(item.data.image ? { image: new URL(item.data.image, Astro.site).href } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: "https://tech46services.fr/" },
      { "@type": "ListItem", position: 2, name: "Conseils & actualités", item: "https://tech46services.fr/conseils-actualites.html" },
      { "@type": "ListItem", position: 3, name: item.data.title },
    ],
  },
]);
---

<BaseLayout
  title={`${item.data.title} - Tech 46 Services`}
  description={item.data.description}
  canonical={canonical}
  ogType="article"
  activePage="conseils-actualites"
  bodyClass="advice-page"
  jsonLd={jsonLd}
>
  <main id="main-content" class="page-main article-page">
    <ArticleHeader title={item.data.title} description={item.data.description}>
      <Breadcrumbs slot="breadcrumbs" items={breadcrumbItems} />
    </ArticleHeader>

    <article aria-label={item.data.title}>
      <div class="card-panel elevation-2 article-content">
        <Content />
      </div>

      <p class="section-footer-link">
        <a class="inline-link" href="/conseils-actualites.html">&larr; Retour aux conseils & actualités</a>
      </p>
    </article>
  </main>
</BaseLayout>
