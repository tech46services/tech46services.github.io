---
import BaseLayout from "../layouts/BaseLayout.astro";

const jsonLd = "{\r\n        \"@context\": \"https://schema.org\",\r\n        \"@type\": \"Service\",\r\n        \"@id\": \"https://tech46services.fr/espace-pro.html#service\",\r\n        \"name\": \"Création web et référencement pour professionnels\",\r\n        \"serviceType\": \"Création de sites web et référencement local\",\r\n        \"description\": \"Création de sites web et référencement pour les professionnels à Gramat et dans le nord du Lot.\",\r\n        \"url\": \"https://tech46services.fr/espace-pro.html\",\r\n        \"provider\": {\r\n          \"@type\": \"LocalBusiness\",\r\n          \"@id\": \"https://tech46services.fr/#business\",\r\n          \"name\": \"Tech 46 Services\",\r\n          \"url\": \"https://tech46services.fr/\",\r\n          \"telephone\": \"+33769754085\"\r\n        },\r\n        \"audience\": {\r\n          \"@type\": \"BusinessAudience\",\r\n          \"audienceType\": \"Professionnels, indépendants, artisans et associations\"\r\n        },\r\n        \"areaServed\": [\r\n          {\r\n            \"@type\": \"AdministrativeArea\",\r\n            \"name\": \"Gramat (Lot)\"\r\n          },\r\n          {\r\n            \"@type\": \"AdministrativeArea\",\r\n            \"name\": \"Nord du Lot (46)\"\r\n          }\r\n        ],\r\n        \"hasOfferCatalog\": {\r\n          \"@type\": \"OfferCatalog\",\r\n          \"name\": \"Création web et référencement\",\r\n          \"itemListElement\": [\r\n            {\r\n              \"@type\": \"OfferCatalog\",\r\n              \"name\": \"Création de sites web\"\r\n            },\r\n            {\r\n              \"@type\": \"OfferCatalog\",\r\n              \"name\": \"Référencement local\"\r\n            }\r\n          ]\r\n        }\r\n      }";
---

<BaseLayout
  title={"Création web & référencement à Gramat | Tech 46 Services"}
  description={"Création de sites web et référencement pour les professionnels à Gramat et dans le nord du Lot. Développez votre visibilité en ligne."}
  canonical={"https://tech46services.fr/espace-pro.html"}
  ogTitle={"Création web & référencement à Gramat | Tech 46 Services"}
  ogDescription={"Création de sites web et référencement pour les professionnels à Gramat et dans le nord du Lot. Développez votre visibilité en ligne."}
  bodyClass={"services-page espace-pro-page"}
  activePage={"espace-pro"}
  jsonLd={jsonLd}
>
<main id="main-content" class="page-main">
        <!-- =========================
             INTRO SERVICES
        ========================== -->
        <h1 id="espace-pro-title" class="hero-intro-title">Création de sites web et référencement à Gramat et dans le nord du Lot</h1>
        <section class="hero-grid" aria-labelledby="espace-pro-title">
          <img loading="eager"
            class="hero-bg"
            src="assets/img/image_espacepro.webp"
            srcset="/assets/img/image_espacepro-480.webp 480w, /assets/img/image_espacepro-720.webp 720w, /assets/img/image_espacepro.webp 958w"
            sizes="(max-width: 1000px) calc(100vw - 2rem), 958px"
            alt="Création web et référencement pour les professionnels"
            width="958"
            height="447"
            decoding="async"
            fetchpriority="high"
          />
          <div class="hero-content reveal">
            <div class="hero-text-panel">
              <p class="intro-text">
                Tech 46 Services accompagne les artisans, TPE, indépendants et associations
                pour créer leur présence en ligne et améliorer leur visibilité sur le web et
                sur Google, avec des solutions claires et adaptées à leur activité.
              </p>
            </div>
          </div>
        </section>

        <!-- =========================
             OFFRES ESPACE PRO
        ========================== -->
        <section class="section-padding">

          <div class="section-header">
            <h2 id="solutions-web">Des solutions web pour développer votre activité</h2>
            <p>Deux prestations complémentaires pour construire une présence en ligne claire et visible.</p>
          </div>

          <p>Votre présence en ligne doit refléter le sérieux de votre activité. Un site web
            clair, rapide et adapté à vos clients renforce votre crédibilité, facilite la prise
            de contact et constitue un véritable outil commercial disponible en permanence.
            Associé à un référencement local cohérent, il vous aide également à gagner en
            visibilité sur Google auprès des personnes qui recherchent vos services.</p>

          <p>J’accompagne les professionnels de Gramat et du nord du Lot de la définition du
            besoin jusqu’à la mise en ligne, puis dans l’amélioration de leur visibilité, avec
            une méthode claire et un interlocuteur unique.</p>
          
          <div class="cards-grid big">
            <article id="creation-sites-web" class="service-card elevation-3 reveal card-top-accent">
              <h3>Création de sites web</h3>

              <p>
                Un site professionnel conçu pour présenter clairement votre activité
                et faciliter la prise de contact avec vos futurs clients.
              </p>

              <ul class="service-list">
                <li>Site rapide et sécurisé</li>
                <li>Design responsive mobile et desktop</li>
                <li>Hébergement simple et maintenance légère</li>
                <li>Pages adaptées à vos besoins et à votre activité</li>
              </ul>
            </article>

            <article id="referencement-local" class="service-card elevation-3 reveal card-top-accent">
              <h3>Référencement local</h3>

              <p>
                Des fondations solides et des contenus pertinents pour aider votre entreprise
                à être trouvée par les clients qui recherchent vos services dans votre secteur.
              </p>

              <ul class="service-list">
                <li>Structure technique optimisée</li>
                <li>Contenus orientés intentions locales</li>
                <li>Amélioration des performances web</li>
                <li>Renforcement de votre visibilité sur Google</li>
              </ul>
            </article>
          </div>

          <div class="section-footer-link why-cta">
            <a href="/contact.html" class="btn primary">Demander un devis pour votre projet web</a>
          </div>
        </section>

        <!-- =========================
             METHODE
        ========================== -->
        <section class="section-padding reveal">
          <div class="section-header">
            <h2>Comment se déroule un projet ?</h2>
            <p>Une méthode claire pour construire une solution web utile à votre activité.</p>
          </div>

          <ul class="service-list why-list" style="max-width: 760px;">
            <li>Échange initial pour cadrer vos besoins et vos priorités</li>
            <li>Proposition d'une solution adaptée à votre budget</li>
            <li>Mise en place progressive et validation à chaque étape</li>
            <li>Accompagnement après la mise en ligne et conseils pour la suite</li>
          </ul>
        </section>

        <section class="section-padding reveal">
          <div class="section-header">
            <h2>Intervention locale et à distance</h2>
            <p>
              Basé à Gramat, j'accompagne les professionnels du Lot en présentiel
              et je peux aussi intervenir à distance selon le projet.
            </p>
          </div>

          <div class="why-cta">
            <a href="/contact.html" class="inline-link">Parlez-moi de votre projet web &rarr;</a>
          </div>
        </section>
      </main>
</BaseLayout>
