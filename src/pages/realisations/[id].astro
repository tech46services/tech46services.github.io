---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getPublicEntries } from "../../utils/content";
import { getPublicImageData } from "../../utils/images";
import { getRealisationBlocks } from "../../utils/realisations";

export async function getStaticPaths() {
  const items = getPublicEntries(await getCollection("realisations"), false);

  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const canonical = `https://tech46services.fr/realisations/${item.id}.html`;
const blocks = getRealisationBlocks(item.body ?? "");
const imageSources = blocks.flatMap((block) => block.type === "step" ? block.images.map((image) => image.src) : []);
const imageDataBySrc = new Map(imageSources.map((src) => [src, getPublicImageData(src)] as const));
const priorityImageSrc = imageSources[0];
const realisationImageSizes = "(max-width: 680px) calc(100vw - 4.1rem), (max-width: 900px) calc(50vw - 3rem), 360px";

const breadcrumbItems = [
  { label: "Accueil", href: "/" },
  { label: "Réalisations", href: "/realisations.html" },
  { label: item.data.title },
];

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: item.data.title,
    description: item.data.description,
    mainEntityOfPage: canonical,
    author: {
      "@type": "Organization",
      name: "Tech 46 Services",
      url: "https://tech46services.fr/apropos.html",
    },
    publisher: {
      "@type": "Organization",
      name: "Tech 46 Services",
      logo: {
        "@type": "ImageObject",
        url: "https://tech46services.fr/assets/img/logo-tech46.png",
      },
    },
    ...(item.data.image ? { image: new URL(item.data.image, Astro.site).href } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: "https://tech46services.fr/" },
      { "@type": "ListItem", position: 2, name: "Réalisations", item: "https://tech46services.fr/realisations.html" },
      { "@type": "ListItem", position: 3, name: item.data.title },
    ],
  },
]);
---

<BaseLayout
  title={`${item.data.title} - Tech 46 Services`}
  description={item.data.description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <main id="main-content">
    <Breadcrumbs items={breadcrumbItems} />
    <h1 class="hero-intro-title">{item.data.title}</h1>

    <article class="section-padding realisation-page">
      <header class="realisation-summary">
        <p class="intro-text">{item.data.description}</p>
      </header>

      <div class="card-panel elevation-2 article-content realisation-content">
        {blocks.map((block) => {
          if (block.type === "heading") return <h2>{block.content}</h2>;

          if (block.type === "text") return <p>{block.content}</p>;

          return (
            <section class="realisation-step">
              <div class="realisation-photo-group" data-count={block.images.length}>
                {block.images.map((image) => {
                  const imageData = imageDataBySrc.get(image.src);
                  const isPriority = image.src === priorityImageSrc;

                  return (
                    <div class="realisation-photo-tile card-top-accent">
                      <img
                        src={image.src}
                        srcset={imageData?.srcset}
                        sizes={imageData?.srcset ? realisationImageSizes : undefined}
                        width={imageData?.width}
                        height={imageData?.height}
                        alt={image.alt}
                        loading={isPriority ? "eager" : "lazy"}
                        fetchpriority={isPriority ? "high" : undefined}
                        decoding="async"
                      />
                    </div>
                  );
                })}
              </div>
              {block.content && <p class="realisation-step-text">{block.content}</p>}
            </section>
          );
        })}
      </div>

      <p class="section-footer-link">
        <a class="inline-link" href="/realisations.html">&larr; Retour aux réalisations</a>
      </p>
    </article>
  </main>
</BaseLayout>
