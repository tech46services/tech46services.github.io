---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { getPublicEntries } from "../utils/content";

const items = getPublicEntries(await getCollection("realisations"));
---

<BaseLayout
  title="Réalisations & Interventions - Tech 46 Services"
  description="Découvrez les interventions et réalisations récentes de Tech 46 Services auprès des particuliers et professionnels dans le Lot."
  canonical="https://tech46services.fr/realisations.html"
  activePage="realisations"
>
  <main class="page-main">
    <h1 class="hero-intro-title">Réalisations & Interventions</h1>

    <section class="section-padding">
      <div class="section-header">
        <h2>Exemples d'interventions</h2>
        <p>Aperçu des pannes résolues et des projets numériques réalisés sur le terrain.</p>
      </div>

      {items.length > 0 ? (
        <div class="cards-grid article-list">
          {items.map((item) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              date={item.data.date}
              category={item.data.category}
              location={item.data.location}
              service={item.data.service}
              image={item.data.image}
              imageAlt={item.data.imageAlt}
              href={`/realisations/${item.id}.html`}
              linkLabel="Voir l'intervention"
            />
          ))}
        </div>
      ) : (
        <div class="card-panel elevation-2 article-empty">
          <p>Les premières réalisations seront publiées prochainement.</p>
        </div>
      )}
    </section>
  </main>
</BaseLayout>