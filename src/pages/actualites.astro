---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { getPublicEntries } from "../utils/content";

const items = getPublicEntries(await getCollection("actualites"));
---

<BaseLayout
  title="Actualités - Tech 46 Services"
  description="Suivez l'actualité, les nouveautés et les annonces de Tech 46 Services à Gramat et dans le Lot."
  canonical="https://tech46services.fr/actualites.html"
>
  <main class="page-main">
    <h1 class="hero-intro-title">Actualités</h1>

    <section class="section-padding">
      <div class="section-header">
        <h2>Dernières informations</h2>
        <p>Retrouvez toutes les nouveautés et annonces de Tech 46 Services.</p>
      </div>

      {items.length > 0 ? (
        <div class="cards-grid article-list">
          {items.map((item) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              date={item.data.date}
              category={item.data.category}
              image={item.data.image}
              imageAlt={item.data.imageAlt}
              href={`/actualites/${item.id}.html`}
              linkLabel="Lire l'actualité"
            />
          ))}
        </div>
      ) : (
        <div class="card-panel elevation-2 article-empty">
          <p>Aucune actualité pour le moment.</p>
        </div>
      )}
    </section>
  </main>
</BaseLayout>