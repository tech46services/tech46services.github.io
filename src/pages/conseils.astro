---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { getPublicEntries } from "../utils/content";

const items = getPublicEntries(await getCollection("conseils"));
---

<BaseLayout
  title="Conseils informatiques - Tech 46 Services"
  description="Conseils pratiques de Tech 46 Services pour entretenir, sécuriser et mieux utiliser votre matériel informatique."
  canonical="https://tech46services.fr/conseils.html"
  activePage="conseils"
  bodyClass="advice-page"
>
  <main class="page-main advice-main">
    <header class="advice-intro">
      <p class="advice-kicker">Guides pratiques</p>
      <h1>Conseils informatiques</h1>
      <p>
        Des conseils simples pour mieux comprendre les pannes courantes, prolonger la vie de
        votre ordinateur et savoir quand une intervention est utile.
      </p>
    </header>

    <section class="section-padding advice-library" aria-labelledby="advice-library-title">
      <div class="section-header">
        <h2 id="advice-library-title">Les conseils à consulter</h2>
        <p>Des repères concrets, issus des situations rencontrées au quotidien.</p>
      </div>

      {items.length > 0 ? (
        <div class="cards-grid article-list">
          {items.map((item) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              date={item.data.date}
              category={item.data.category}
              image={item.data.image}
              imageAlt={item.data.imageAlt}
              href={`/conseils/${item.id}.html`}
              linkLabel="Lire le conseil"
              showDate={false}
            />
          ))}
        </div>
      ) : (
        <div class="card-panel elevation-2 article-empty">
          <p>Les premiers conseils seront publiés prochainement.</p>
        </div>
      )}
    </section>

    <aside class="card-panel advice-cta" aria-labelledby="advice-cta-title">
      <div>
        <h2 id="advice-cta-title">Le problème persiste&nbsp;?</h2>
        <p>Un diagnostic permet de déterminer la solution la plus adaptée à votre matériel.</p>
      </div>
      <a class="btn ghost" href="/depannage.html">Découvrir le dépannage</a>
    </aside>
  </main>
</BaseLayout>
