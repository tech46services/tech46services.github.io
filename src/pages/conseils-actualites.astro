---
import { getCollection } from "astro:content";
import ContentCard from "../components/ContentCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicEntries } from "../utils/content";

const conseils = getPublicEntries(await getCollection("conseils"));
const actualites = getPublicEntries(await getCollection("actualites"));
const hasContent = conseils.length > 0 || actualites.length > 0;
---

<BaseLayout
  title="Conseils & actualités | Tech 46 Services"
  description="Conseils pratiques, informations et actualités de Tech 46 Services autour du dépannage informatique, du matériel et des usages numériques."
  canonical="https://tech46services.fr/conseils-actualites.html"
  activePage="conseils-actualites"
  bodyClass="advice-page"
>
  <main class="page-main">
    <h1 class="hero-intro-title">Conseils & actualités</h1>

    {conseils.length > 0 && (
      <section class="section-padding advice-library" aria-labelledby="practical-advice-title">
        <div class="section-header">
          <h2 id="practical-advice-title">Conseils pratiques</h2>
          <p>Des repères concrets, issus des situations rencontrées au quotidien.</p>
        </div>

        <div class="cards-grid article-list">
          {conseils.map((item, index) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              date={item.data.date}
              category={item.data.category}
              image={item.data.image}
              imageAlt={item.data.imageAlt}
              href={`/conseils/${item.id}.html`}
              linkLabel="Lire le conseil"
              showDate={false}
              priority={index === 0}
            />
          ))}
        </div>
      </section>
    )}

    {actualites.length > 0 && (
      <section class="section-padding advice-library" aria-labelledby="tech46-news-title">
        <div class="section-header">
          <h2 id="tech46-news-title">Actualités Tech 46 Services</h2>
          <p>Les nouveautés, informations et annonces de Tech 46 Services.</p>
        </div>

        <div class="cards-grid article-list">
          {actualites.map((item) => (
            <ContentCard
              title={item.data.title}
              description={item.data.description}
              date={item.data.date}
              category={item.data.category}
              image={item.data.image}
              imageAlt={item.data.imageAlt}
              href={`/actualites/${item.id}.html`}
              linkLabel="Lire l'actualité"
            />
          ))}
        </div>
      </section>
    )}

    {!hasContent && (
      <div class="card-panel elevation-2 article-empty content-hub-empty">
        <p>Les premiers conseils et actualités seront publiés prochainement.</p>
      </div>
    )}

    <aside class="card-panel advice-cta" aria-labelledby="advice-cta-title">
      <div>
        <h2 id="advice-cta-title">Le problème persiste&nbsp;?</h2>
        <p>Un diagnostic permet de déterminer la solution la plus adaptée à votre matériel.</p>
      </div>
      <a class="btn ghost" href="/depannage.html">Découvrir le dépannage</a>
    </aside>
  </main>
</BaseLayout>
